{
  "name": "dsh-science-panel",
  "version": "0.1.0",
  "description": "Open a locally running Claude Science instance inside DeepSeek Harness.",
  "repository": {"type":"git","url":"https://github.com/Ysx12138/dsh-science-panel.git"},
  "homepage": "https://github.com/Ysx12138/dsh-science-panel#readme",
  "bugs": {"url":"https://github.com/Ysx12138/dsh-science-panel/issues"},
  "keywords": ["dsh-plugin", "deepseek-harness", "claude-science"],
  "type": "module",
  "main": "./lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "third-party"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "license": "MIT"
}
